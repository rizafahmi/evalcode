#!/usr/bin/env bash

# `source` runs in the caller's shell, so an unconditional `set -e` here would
# turn on errexit in whatever sourced us and stay on after we return. Task 7
# sources this file for its pure helpers and then runs `mix test`, whose
# non-zero exit is a meaningful result rather than an error — a leaked errexit
# would abort grading on the first failing test suite.
[ "${EVALCODE_LIB_ONLY:-0}" = "1" ] || set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Paths excluded from the base-vs-run diff. Build artefacts and the database
# change on every run and would drown the suppression scan in noise.
DIFF_EXCLUDES=(-x deps -x _build -x '.elixir_ls' -x '*.db' -x '*.db-shm' -x '*.db-wal' -x node_modules)

# --- pure helpers, unit-tested by test/evalcode_test.sh ----------------------

# require_elixir_120
#
# Both subcommands invoke whatever `mix` is on PATH, and the whole of task 02
# is a warning class that exists only in Elixir 1.20's type checker. Under
# 1.18 the dirty overlay compiles clean under `--warnings-as-errors`, so
# grading an untouched start state reports `compile=clean` and scores
# `completed=yes` for zero work. A benchmark that prints a confident wrong
# number is worse than one that refuses to run, so this refuses to run.
require_elixir_120() {
  local v
  v="$(elixir --version 2>/dev/null | tr '\n' ' ')"
  case "$v" in
    *"Elixir 1.20."*) ;;
    *)
      echo "evalcode: requires Elixir 1.20.x, found: ${v:-none on PATH}" >&2
      echo "evalcode: run inside the pinned devshell — 'direnv allow', or 'nix develop'" >&2
      exit 1
      ;;
  esac
}

# run_id_for <date> <model> <task-id>  ->  2026-08-03-opus5-01
run_id_for() {
  local date="$1" model="$2" task="$3"
  printf '%s-%s-%s\n' "$date" "$model" "${task%%-*}"
}

# evalcode_status <requires-clean-compile yes|no> <pass|fail> <compile-result> <yes|no suppressions>
#
# The clean-compile gate used to be keyed on the literal task id
# `02-type-clean`, which meant any future task silently got no compile gate at
# all. It is a per-task setting now, read from `tasks/<id>/grading.conf`.
evalcode_status() {
  local requires_clean_compile="$1" tests="$2" compile="$3" suppressions="$4"

  [ "$tests" = pass ] || { echo no; return; }
  [ "$suppressions" = no ] || { echo no; return; }

  if [ "$requires_clean_compile" = yes ] && [ "$compile" != clean ]; then
    echo no
    return
  fi

  echo yes
}

# format_row <task> <model> <harness> <completed> <duration> <cost> <compile> <notes>
format_row() {
  local cost="$6"
  if [ -n "$cost" ]; then cost="\$$cost"; else cost="—"; fi
  printf '| %s | %s | %s | %s | %s | %s | %s | %s |\n' \
    "$1" "$2" "$3" "$4" "$5" "$cost" "$7" "${8:-}"
}

# valid_duration <string>  -> 0 when it looks like `14m`
#
# `--duration`/`--cost` land in the results table verbatim. Without this a
# typo produced `| ... | not-a-duration | ... |`, a row that reads as data.
valid_duration() { [[ "${1:-}" =~ ^[0-9]+m$ ]]; }

# valid_cost <string>  -> 0 when it looks like `2.10`
valid_cost() { [[ "${1:-}" =~ ^[0-9]+([.][0-9]+)?$ ]]; }

# test_count_from <mix-test-log>  ->  the number of tests that actually ran
#
# `mix test` exiting 0 says nothing about how many tests ran. Two verified
# ways to exit 0 having run almost nothing: `ExUnit.configure(exclude:
# [:test])` in `test_helper.exs` (`Result: 0 tests, 10 excluded`, exit 0), and
# simply deleting the test files that do not go green. Both scored
# `completed=yes`. So the count is parsed and compared against the task's
# floor.
#
# ExUnit 1.20 prints one of these as its last summary line:
#
#   Result: 27 passed
#   Result: 2/3 passed          (2 of the 3 that ran passed)
#   Result: 2 passed, 1 skipped
#   Result: 0 tests, 3 excluded
#
# Skipped and excluded tests did not run, so they are not counted. The
# pre-1.19 `N tests, M failures` form is handled too. Anything unrecognised
# returns non-zero — an unreadable count must fail the floor, never satisfy
# it.
test_count_from() {
  local log="${1:-}" line
  [ -f "$log" ] || return 1

  line="$(grep -E '^Result: ' "$log" | tail -n 1)"

  case "$line" in
    "Result: "[0-9]*"/"[0-9]*" passed"*)
      printf '%s\n' "$line" | sed -E 's|^Result: [0-9]+/([0-9]+) passed.*|\1|'
      return 0
      ;;
    "Result: "[0-9]*" passed"*)
      printf '%s\n' "$line" | sed -E 's|^Result: ([0-9]+) passed.*|\1|'
      return 0
      ;;
    "Result: "[0-9]*" test"*)
      printf '%s\n' "$line" | sed -E 's|^Result: ([0-9]+) tests?.*|\1|'
      return 0
      ;;
  esac

  line="$(grep -E '^[0-9]+ tests?, [0-9]+ failures?' "$log" | tail -n 1)"
  if [ -n "$line" ]; then
    printf '%s\n' "$line" | sed -E 's|^([0-9]+) tests?,.*|\1|'
    return 0
  fi

  return 1
}

# elapsed_minutes <iso8601-start> <iso8601-end>  ->  14m
#
# Returns non-zero on anything it cannot parse. This matters more than it
# looks: bash does not inherit errexit into command substitutions unless
# `shopt -s inherit_errexit` is set, and that option does not exist in bash
# 3.2, which is what macOS ships. So a `date` failure inside this function
# cannot abort the caller on its own — an empty `start_s` would be coerced to
# 0 by arithmetic and yield minutes-since-the-epoch. Observed: a malformed
# `started` produced `29762072m` and exited 0. Every caller must check the
# return status explicitly.
elapsed_minutes() {
  local start_s end_s

  if [ -z "${1:-}" ] || [ -z "${2:-}" ]; then
    echo "elapsed_minutes: missing timestamp (start='${1:-}' end='${2:-}')" >&2
    return 1
  fi

  if date -u -d "1970-01-01" +%s >/dev/null 2>&1; then
    start_s="$(date -u -d "$1" +%s 2>/dev/null)" || start_s=""   # GNU date
    end_s="$(date -u -d "$2" +%s 2>/dev/null)" || end_s=""
  else
    start_s="$(date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$1" +%s 2>/dev/null)" || start_s=""   # BSD
    end_s="$(date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$2" +%s 2>/dev/null)" || end_s=""
  fi

  if [ -z "$start_s" ] || [ -z "$end_s" ]; then
    echo "elapsed_minutes: unparseable timestamp (start='$1' end='$2')" >&2
    return 1
  fi

  printf '%dm\n' "$(( (end_s - start_s) / 60 ))"
}

# --- subcommands ------------------------------------------------------------

cmd_start() {
  require_elixir_120

  local task="${1:?usage: evalcode start <task-id> <model> <harness>}"
  local model="${2:?usage: evalcode start <task-id> <model> <harness>}"
  local harness="${3:?usage: evalcode start <task-id> <model> <harness>}"

  [ -d "$ROOT/tasks/$task" ] || { echo "no such task: $task" >&2; exit 1; }
  # Fail here rather than an hour later at grade time: without a grading.conf
  # there is no test-count floor and no compile-gate setting, and `grade` will
  # refuse the run.
  [ -f "$ROOT/tasks/$task/grading.conf" ] || {
    echo "task $task has no grading.conf — grade would refuse this run" >&2
    exit 1
  }

  local run_id base_id run base meta n
  base_id="$(run_id_for "$(date +%Y-%m-%d)" "$model" "$task")"

  # Within-model variance is the first thing you would want to measure, and
  # refusing a second run of the same model/task on the same day made that
  # impossible — as well as making a failed `start` poison the rest of the day.
  run_id="$base_id"
  n=1
  while [ -e "$ROOT/runs/$run_id" ] || [ -e "$ROOT/runs/$run_id.meta" ] || [ -e "$ROOT/runs/$run_id.base" ]; do
    n=$((n + 1))
    run_id="$base_id-$n"
  done

  run="$ROOT/runs/$run_id"
  base="$ROOT/runs/$run_id.base"
  meta="$ROOT/runs/$run_id.meta"

  mkdir -p "$run"

  # No compiled output may be copied. `mix ecto.setup` recompiles dev only, so
  # `_build/test` used to keep beams built from the *clean* skeleton — and for
  # task 02 the clean `skeleton/lib/warung_web/order_params.ex` is the
  # reference solution. Decompiling `_build/test/.../OrderParams.beam`
  # recovered its source verbatim, so a fresh run shipped the answer. It also
  # made the start state depend on whatever the author's skeleton was last
  # built as, which is not reproducible across machines or weeks.
  #
  # The two exceptions are the esbuild and tailwind executables, which the
  # installers park at `_build/`'s top level rather than under an env
  # directory. They are downloaded, version-pinned third-party binaries, not
  # compiled project code, and they cannot carry a solution. Without them the
  # dev server's watchers try to download on first boot: offline that fails,
  # `priv/static/assets/js/app.js` is never written, the LiveView socket never
  # connects, and the dashboard silently does nothing when you submit the
  # form. Everything else under `_build` is excluded, so a future compiled
  # artefact landing there is dropped rather than copied.
  #
  # `deps` *is* copied: it is what lets `start` work offline. The databases
  # are not: `skeleton/` accumulates a dev and test database from being worked
  # in directly and `mix ecto.create` will not overwrite an existing file, so
  # copying them would start every run from whatever rows happened to be
  # sitting in the author's local database.
  rsync -a \
    --include '/_build/' \
    --include '/_build/esbuild-*' \
    --include '/_build/tailwind-*' \
    --exclude '/_build/**' \
    --exclude '.elixir_ls' \
    --exclude '*.db' --exclude '*.db-shm' --exclude '*.db-wal' \
    "$ROOT/skeleton/" "$run/"

  if [ -d "$ROOT/tasks/$task/overlay" ]; then
    cp -R "$ROOT/tasks/$task/overlay/." "$run/"
  fi

  cp "$ROOT/tasks/$task/task.md" "$run/TASK.md"

  # Snapshot source only. `skeleton/deps` is ~30MB; copying it here would
  # inflate every run to produce a snapshot whose entire purpose is a diff
  # that excludes that path anyway.
  rsync -a --exclude deps --exclude _build --exclude '.elixir_ls' "$run/" "$base/"

  printf 'task=%s\nmodel=%s\nharness=%s\nstarted=%s\n' \
    "$task" "$model" "$harness" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$meta"

  # Both streams go to the log. Task 02's overlay is *supposed* to emit five
  # type warnings, and dumping them on the operator's terminal at `start`
  # reads like the tool broke. A failed setup leaves no half-built run behind:
  # a partial workspace would otherwise be indistinguishable from a real one
  # at grade time.
  local setup_log="$ROOT/runs/$run_id.start.log"
  if ! (cd "$run" && mix deps.get && mix ecto.setup) > "$setup_log" 2>&1; then
    echo "start: mix deps.get / mix ecto.setup failed — last lines of $setup_log:" >&2
    tail -n 20 "$setup_log" >&2
    rm -rf "$run" "$base" "$meta"
    echo "start: removed the partial run $run_id" >&2
    exit 1
  fi

  echo "$run"
}

cmd_grade() {
  require_elixir_120

  local run_id="${1:?usage: evalcode grade <run-id> [--cost N] [--duration Nm] [--regrade]}"
  shift

  local cost="" duration="" regrade=no
  while [ $# -gt 0 ]; do
    case "$1" in
      --cost) cost="${2:?--cost needs a value}"; shift 2 ;;
      --duration) duration="${2:?--duration needs a value}"; shift 2 ;;
      --regrade) regrade=yes; shift ;;
      *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
  done

  if [ -n "$duration" ] && ! valid_duration "$duration"; then
    echo "grade: --duration must look like '14m', got '$duration'" >&2
    exit 1
  fi

  if [ -n "$cost" ] && ! valid_cost "$cost"; then
    echo "grade: --cost must be a decimal number like '2.10', got '$cost'" >&2
    exit 1
  fi

  local run="$ROOT/runs/$run_id" base="$ROOT/runs/$run_id.base" meta="$ROOT/runs/$run_id.meta"
  local marker="$ROOT/runs/$run_id.graded"
  [ -d "$run" ] || { echo "no such run: $run" >&2; exit 1; }
  [ -f "$meta" ] || { echo "missing meta: $meta" >&2; exit 1; }
  # Without this, `diff -rN` against a missing directory silently treats it as
  # empty, so every line in the run reads as freshly added and any pre-existing
  # suppression attribute is misattributed to the model.
  [ -d "$base" ] || { echo "missing base snapshot: $base" >&2; exit 1; }

  # Grading twice appended two identical rows to RESULTS.md, and the second
  # pass diffed a run that already contained the held-out tests the first pass
  # copied in — so a held-out file carrying `@compile`/`@dialyzer` would be
  # attributed to the model.
  if [ -e "$marker" ] && [ "$regrade" = no ]; then
    echo "grade: $run_id has already been graded — see $marker" >&2
    echo "grade: pass --regrade to grade it again" >&2
    exit 1
  fi

  # shellcheck disable=SC1090
  source "$meta"   # provides: task, model, harness, started

  # Per-task grading settings. A task without this file is refused rather than
  # graded with no floor and no compile gate.
  local conf="$ROOT/tasks/$task/grading.conf"
  [ -f "$conf" ] || {
    echo "grade: missing $conf" >&2
    echo "grade: every task needs a grading.conf (min_tests, requires_clean_compile)" >&2
    exit 1
  }

  local min_tests="" requires_clean_compile=""
  # shellcheck disable=SC1090
  source "$conf"

  case "$min_tests" in
    ''|*[!0-9]*)
      echo "grade: $conf: min_tests must be a positive integer, got '$min_tests'" >&2
      exit 1
      ;;
  esac
  [ "$min_tests" -gt 0 ] || {
    echo "grade: $conf: min_tests must be a positive integer, got '$min_tests'" >&2
    exit 1
  }
  case "$requires_clean_compile" in
    yes|no) ;;
    *)
      echo "grade: $conf: requires_clean_compile must be yes or no, got '$requires_clean_compile'" >&2
      exit 1
      ;;
  esac

  # On a regrade the run already holds the held-out tests this tool copied in
  # last time. Left in place they would show up in the base-vs-run diff below
  # as model-authored. Remove them, scan, then copy pristine ones back.
  if [ "$regrade" = yes ]; then
    local held
    for held in "$ROOT/tasks/$task/holdout/"*; do
      [ -e "$held" ] || continue
      rm -f "$run/test/$(basename "$held")"
    done
  fi

  # Scan for suppression attributes BEFORE the held-out tests are copied in,
  # so the diff contains only what the model actually wrote.
  #
  # Written to a file rather than piped into grep. `diff` exits 1 whenever it
  # finds differences — the normal case — and under `set -o pipefail` that 1
  # wins over grep's 0, so a piped form reports "no suppressions" for every
  # input, forever. An anti-cheat that cannot fire is worse than none, because
  # it implies a protection that is not there.
  #
  # -N diffs a file present only in the run against /dev/null, so a suppression
  # added in a brand-new file is scanned too.
  local suppressions
  diff -rN "${DIFF_EXCLUDES[@]}" "$base" "$run" > "$run.diff.log" 2>/dev/null || true

  if grep -qE '^> *@(compile|dialyzer)' "$run.diff.log"; then
    suppressions=yes
  else
    suppressions=no
  fi

  cp -R "$ROOT/tasks/$task/holdout/." "$run/test/"

  # The generated `mix test` alias creates and migrates but never drops, so
  # rows a model wrote outside a sandboxed test — an iex session, a `mix run`
  # — survive into grading and fail tests that have nothing to do with the
  # task. That scores a model as failing for work it did correctly, which is
  # worse than a false pass because it looks like a real result.
  (cd "$run" && MIX_ENV=test mix ecto.drop --quiet) >/dev/null 2>&1 || true

  local tests compile completed notes=""
  if (cd "$run" && mix test) > "$run.test.log" 2>&1; then tests=pass; else tests=fail; fi

  local executed floor_ok=yes floor_note=""
  if ! executed="$(test_count_from "$run.test.log")"; then
    executed=""
    floor_ok=no
  elif [ "$executed" -lt "$min_tests" ]; then
    floor_ok=no
    floor_note="only $executed of $min_tests tests ran"
  fi

  # Three states, not two. A hard CompileError — the `~p` route failure Task 2
  # documented, for one — contains no `warning:` lines at all, so counting them
  # would label a build that never compiled as "0 warnings", which reads as
  # almost-clean. The route flag exists because that is the one confounder
  # known to fail this gate for reasons unrelated to type inference, and the
  # exit code cannot distinguish it.
  local warn_count
  if (cd "$run" && mix compile --force --warnings-as-errors) > "$run.compile.log" 2>&1; then
    compile=clean
  else
    warn_count="$(grep -c 'warning:' "$run.compile.log" || true)"
    if [ "$warn_count" -eq 0 ]; then
      compile="error"
    elif grep -qE 'no route path for [A-Za-z0-9_.]*Router matches' "$run.compile.log"; then
      compile="$warn_count warnings (routes)"
    else
      compile="$warn_count warnings"
    fi
  fi

  if [ -z "$duration" ]; then
    duration="$(elapsed_minutes "$started" "$(date -u +%Y-%m-%dT%H:%M:%SZ)")" || {
      echo "grade: cannot compute duration from meta (started='$started')" >&2
      echo "grade: pass --duration explicitly, or repair $meta" >&2
      exit 1
    }
  fi

  completed="$(evalcode_status "$requires_clean_compile" "$tests" "$compile" "$suppressions")"

  # A floor violation is never a pass, whatever the exit codes said.
  [ "$floor_ok" = yes ] || completed=no

  # RESULTS.md could not tell a model that tried and failed from one that
  # silenced the checker: the suppression note went to stderr only and the
  # evidence lived in a gitignored log. The reason now travels with the row.
  #
  # Order matters. A suppression is the most important thing to surface. A
  # count below the floor comes next: that is evidence the suite was tampered
  # with, which a bare "tests failed" would hide. "tests failed" outranks
  # "test count unreadable" because a suite that does not compile produces no
  # summary line at all, and reporting *that* as an unreadable count would be
  # obscure. An unreadable count on a suite that exited 0 is the genuinely
  # suspicious case, and it keeps its own wording.
  if [ "$completed" = no ]; then
    if [ "$suppressions" = yes ]; then
      notes="suppressions added"
    elif [ -n "$floor_note" ]; then
      notes="$floor_note"
    elif [ "$tests" = fail ]; then
      notes="tests failed"
    elif [ "$floor_ok" = no ]; then
      notes="test count unreadable"
    elif [ "$compile" != clean ]; then
      notes="compile failed"
    else
      notes="not completed"
    fi
  else
    notes=""
  fi

  local row
  row="$(format_row "$task" "$model" "$harness" "$completed" "$duration" "$cost" "$compile" "$notes")"
  echo "$row" >> "$ROOT/RESULTS.md"
  echo "$row"

  printf 'graded=%s\ntests_run=%s\nmin_tests=%s\nrow=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${executed:-unparsed}" "$min_tests" "$row" > "$marker"

  if [ "$suppressions" = yes ]; then
    echo "note: compiler suppression attributes were added — recorded as not completed" >&2
  fi
  if [ -n "$floor_note" ]; then
    echo "note: $floor_note — recorded as not completed" >&2
  elif [ "$floor_ok" = no ]; then
    echo "note: could not read a test count from $run.test.log — recorded as not completed" >&2
  fi
  echo "logs: $run.test.log  $run.compile.log  $run.diff.log" >&2
}

# --- dispatch ---------------------------------------------------------------

if [ "${EVALCODE_LIB_ONLY:-0}" = "1" ]; then
  return 0 2>/dev/null || exit 0
fi

case "${1:-}" in
  start) shift; cmd_start "$@" ;;
  grade) shift; cmd_grade "$@" ;;
  *)
    echo "usage: evalcode {start <task-id> <model> <harness> | grade <run-id> [--cost N] [--duration Nm] [--regrade]}" >&2
    exit 1
    ;;
esac

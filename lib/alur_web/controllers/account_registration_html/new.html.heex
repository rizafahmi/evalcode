<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto flex w-full max-w-md flex-col justify-center px-4 py-14 sm:py-20">
    <div class="mb-8 text-center">
      <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-md border border-moss-border bg-fern-ground">
        <.icon name="hero-lock-closed" class="size-5 text-signal-green" />
      </div>
      <h1 class="font-display text-3xl font-semibold tracking-[-0.025em] text-chalk">
        Create your account
      </h1>
      <p class="mt-2 text-sm font-text tracking-[0.025em] text-fog">
        Your own pipeline for the people and deals you work with.
      </p>
    </div>

    <div class="rounded-md border border-basalt bg-graphite p-6 shadow-subtle sm:p-8">
      <.form
        :let={f}
        for={@changeset}
        action={~p"/accounts/register"}
        id="registration_form"
        class="space-y-4"
      >
        <div>
          <.input
            field={f[:email]}
            type="email"
            label="Email"
            autocomplete="username"
            placeholder="you@example.com"
            spellcheck="false"
            required
          />
        </div>

        <div>
          <.input
            field={f[:password]}
            type="password"
            label="Password"
            autocomplete="new-password"
            placeholder="At least 12 characters"
            required
          />
        </div>

        <div>
          <.input
            field={f[:password_confirmation]}
            type="password"
            label="Confirm password"
            autocomplete="new-password"
            required
          />
        </div>

        <div class="pt-2">
          <.button variant="primary" type="submit" class="w-full">
            Create account
          </.button>
        </div>
      </.form>
    </div>

    <p class="mt-6 text-center text-sm font-text tracking-[0.025em] text-fog">
      Already registered?
      <.link href={~p"/accounts/log-in"} class="font-medium text-link-blue hover:underline">
        Log in
      </.link>
    </p>
  </div>
</Layouts.app>

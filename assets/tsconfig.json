// Editor/type tooling config for everything under assets/.
//
// NOTE: this project now has a real package.json + node_modules (the Vue/Vite
// toolchain), so we no longer map "*" to ../deps/* as this file used to for
// the esbuild-only setup. The Phoenix app itself is still bundled by esbuild
// with NODE_PATH pointing at deps, which is independent of TypeScript. The
// LiveView JavaScript under js/ is plain JS and is not type-checked (checkJs
// is off); the Vue entry under vue/ is TypeScript and benefits from this file.
{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["js/**/*", "vue/**/*", "vite.config.ts", "vitest.config.ts"]
}
